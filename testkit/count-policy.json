{
  "schema_version": 2,
  "protocol": "etcd-v3.5.23",
  "rules": [
    {
      "id": "exact_get",
      "request": "Range exact key, count_only=false, any limit",
      "count": "len(Kvs), exactly 0 or 1",
      "more": "false",
      "case_ids": [
        "C01"
      ]
    },
    {
      "id": "unlimited_range",
      "request": "Range non-exact key with no positive limit and count_only=false",
      "count": "len(all visible Kvs)",
      "more": "false",
      "case_ids": [
        "C02"
      ]
    },
    {
      "id": "limited_range",
      "request": "Range non-exact key with limit>0 and count_only=false",
      "count": "len(Kvs in this page)",
      "more": "true iff a next visible matching KV exists",
      "case_ids": [
        "C03"
      ]
    },
    {
      "id": "exact_count_only",
      "request": "Range exact key, count_only=true",
      "count": "real existence 0 or 1; Kvs is empty",
      "more": "false",
      "case_ids": [
        "C04"
      ]
    },
    {
      "id": "prefix_count_only_limit_one",
      "request": "Range prefix/range, count_only=true, limit=1",
      "count": "real existence 0 or 1; Kvs is empty",
      "more": "false",
      "case_ids": [
        "C05"
      ]
    },
    {
      "id": "other_range_count_only",
      "request": "Range non-exact count_only=true except the limit=1 accepted form",
      "count": "not produced",
      "more": "not produced",
      "error": "UNIMPLEMENTED",
      "case_ids": [
        "C05"
      ]
    }
  ],
  "accepted_differences": [
    {
      "rule_id": "exact_get",
      "method": "etcdserverpb.KV/Range",
      "case_ids": [
        "C01",
        "C06"
      ],
      "field": "Count",
      "successful_responses_only": true,
      "target_count": "result_length",
      "request_guard": "ordinary_exact_with_revision_filter",
      "scope": "Successful ordinary exact Range with a nonzero revision filter reports len(Kvs); native v3.5.23 may report the unfiltered count",
      "preserved_fields": [
        "Kvs",
        "More",
        "Header",
        "revision",
        "errors"
      ]
    },
    {
      "rule_id": "unlimited_range",
      "method": "etcdserverpb.KV/Range",
      "case_ids": [
        "C02",
        "C06"
      ],
      "field": "Count",
      "successful_responses_only": true,
      "target_count": "result_length",
      "request_guard": "ordinary_nonpoint_without_positive_limit_with_revision_filter",
      "scope": "Successful ordinary non-exact Range with no positive Limit and a nonzero revision filter reports len(Kvs); native v3.5.23 may report the unfiltered count",
      "preserved_fields": [
        "Kvs",
        "More",
        "Header",
        "revision",
        "errors"
      ]
    },
    {
      "rule_id": "limited_range",
      "method": "etcdserverpb.KV/Range",
      "case_ids": [
        "C03"
      ],
      "field": "Count",
      "successful_responses_only": true,
      "target_count": "page_length",
      "scope": "Successful ordinary Range with limit>0 reports len(Kvs in this page) instead of total matching keys",
      "preserved_fields": [
        "Kvs",
        "More",
        "Header",
        "revision",
        "errors"
      ],
      "request_guard": "ordinary_nonpoint_positive_limit"
    },
    {
      "rule_id": "prefix_count_only_limit_one",
      "method": "etcdserverpb.KV/Range",
      "case_ids": [
        "C05"
      ],
      "field": "Count",
      "successful_responses_only": true,
      "target_count": "existence_0_or_1",
      "scope": "Successful range CountOnly with Limit=1 reports existence 0/1 instead of total matching keys",
      "preserved_fields": [
        "Kvs",
        "More",
        "Header",
        "revision",
        "errors"
      ],
      "request_guard": "nonpoint_count_only_limit_one"
    }
  ]
}
